{
  "ts": "2026-07-01T01:09:06.902124+00:00",
  "mode": "hermes",
  "version": "427",
  "changed": "strategy.update_frequency",
  "old": 600,
  "new": 30,
  "reason": "600s (10-min) cadence is far too slow for an ETH/USDT market maker \u00e2\u20ac\u201d quotes are stale by the time mid drifts, so the loop captures directional moves instead of spread. Trade tape confirms: per-trade returns 15-60%, holding gaps 20-40 min (>> max_holding_minutes=5), equity compounding ~760x in 25 fills, and visible 7% drawdown on inventory reversals. Dropping update_frequency to 30s forces the A-S solver to re-quote every 30s against a near-current mid, collapsing holding time and shifting P&L source from drift to spread capture. Expected effect: return-per-trade falls toward target_return_30d=5%, per-trade variance compresses enough to push Sharpe above 1.2, and max drawdown stays inside the 8% gate. Gamma/k/spread/horizon knobs are secondary: spreads are already clamped to 0.0015-0.004 so spread math is saturated, and gamma only rescales exposure at update time \u00e2\u20ac\u201d neither fixes the timing structure that is producing the directional swing behavior observed in the trade tape.",
  "score_before": 0.6752,
  "trades_used": 25,
  "archive": "C:\\Users\\schae\\hermes-trading\\state\\history\\v0426.yaml",
  "one_variable_only": true
}

