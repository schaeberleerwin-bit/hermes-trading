  "new": 6400.0,
  "reason": "Avellaneda-Stoikov gamma controls both reservation-price spread and inventory penalty. Paper run (v430, 24 fills / 27 min, 100% winners, zero drawdown) is unrealistically perfect \u00e2\u20ac\u201d live markets introduce adverse selection that will punish quotes that tight. Raising gamma 4800 \u00e2\u2020\u2019 6400 widens the effective quote ~33% (\u00ce\u00b3\u00c2\u00b7\u00cf\u0192\u00c2\u00b2\u00c2\u00b7T term) and raises the inventory penalty ~33%, capturing more edge per fill and damping inventory build-up. Stays comfortably under max_spread_percent=0.004 and above min_spread=0.0015, so the safety rails still bind. Combined with the existing max_position_size_usd=25 cap, peak single-side exposure remains <0.25% of equity, keeping drawdown well inside the 8% limit while targeting the 5%/30d return goal with a more realistic Sharpe path toward 1.2.",
  "score_before": 0.3,
  "trades_used": 25,
  "archive": "C:\\Users\\schae\\hermes-trading\\state\\history\\v0430.yaml",
  "one_variable_only": true
}

