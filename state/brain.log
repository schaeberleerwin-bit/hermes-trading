{
  "ts": "2026-06-30T18:08:46.079665+00:00",
  "mode": "hermes",
  "version": "424",
  "changed": "strategy.k",
  "old": 1.5,
  "new": 0.5,
  "reason": "Lower k (order-arrival intensity) widens the Avellaneda-Stoikov optimal spread, which reduces fill frequency and adverse-selection losses. The current trades show per-trade returns of 18-95% compounded on scaling equity (15,861 \u00e2\u2020\u2019 17,429,356 in one session) \u00e2\u20ac\u201d clearly not spread-capture but equity-scaled directional PnL leaking through. Widening the spread via k: 1.5 \u00e2\u2020\u2019 0.5 converts the strategy from over-trading into a true inventory-bearing market maker, aligning expected return with the modest 5% monthly target while keeping max drawdown inside the 8% band and Sharpe \u00e2\u2030\u00a5 1.2.",
  "score_before": 0.8322,
  "trades_used": 25,
  "archive": "C:\\Users\\schae\\hermes-trading\\state\\history\\v0423.yaml",
  "one_variable_only": true
}

